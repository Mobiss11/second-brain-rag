# Настройки. Скопировать в .env и заполнить.
# Ключи и адреса провайдеров.

# Эмбеддинги: любой OpenAI-совместимый API
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_MODEL=perplexity/pplx-embed-v1-4b
EMBED_DIM=2560

# Модель ответа
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Только для Yandex Cloud, у остальных оставить пустым
LLM_PROJECT=

# Qdrant: локальный файл или сервер
QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Поиск и ответ
COLLECTION=kb
TOP_K=4
MIN_SCORE=0.35
JUDGE=1
